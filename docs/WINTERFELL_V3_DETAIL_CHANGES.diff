+    /**
+     * Settlement reservations for the vanilla biome decoration pass.
+     *
+     * Trees and lava lakes are generated by biome features, often from a
+     * NEIGHBORING source chunk. Suppressing vegetation only in the target
+     * chunk is insufficient. Reserve a two-chunk margin around buildings and
+     * a one-chunk margin around planned roads; reserve the entire castle ward.
+     * This is worldgen-only and leaves pre-existing chunks untouched.
+     */
+    public static boolean suppressNaturalDecoration(ChunkAccess chunk) {
+        if (!ENABLED) return false;
+        int cx=chunk.getPos().x(), cz=chunk.getPos().z();
+        long bx=((long)cx<<4)-X, bz=((long)cz<<4)-Z;
+        if (Math.abs(bx)>4_600 || Math.abs(bz)>4_600) return false;
+        if (Math.abs(bx)<=288 && Math.abs(bz)<=288) return true;
+        Plan p=plan();
+        for(int dz=-2;dz<=2;dz++)for(int dx=-2;dx<=2;dx++) {
+            ChunkPlan nearby=p.chunks.get(key(cx+dx,cz+dz));
+            if(nearby==null)continue;
+            if(nearby.buildings.length>0)return true;
+            if(Math.abs(dx)<=1&&Math.abs(dz)<=1&&!nearby.roads.isEmpty())return true;
+        }
+        return false;
+    }
