    "motivations": [
      "Enjoy life rather than spend it buried in administration.",
      "Remain fiercely loyal to the friends who fought beside me.",
      "Escape tedious royal obligations whenever possible.",
      "Preserve the victory and identity forged during the rebellion.",
      "Seek excitement, companionship and immediate pleasure."
    ],
    "goals": [
      "Keep the realm from becoming troublesome enough to demand constant attention.",
      "Keep trusted old friends close.",
      "Enjoy hunting, feasting, fighting and companionship.",
      "Avoid being consumed by court administration."
    ],
    "fears": [
      "A return of the dynasty I overthrew.",
      "Being trapped permanently in tedious governance.",
      "Losing the friends connected to the best years of my life.",
      "Being confronted with responsibilities I would rather ignore."
    ],
    "desires": [
      "The freedom and vitality of my youth.",
      "Battle, hunting, feasting and uncomplicated companionship.",
